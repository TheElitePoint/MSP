# Copy to .env and fill in. .env is gitignored.

# Tavily — web search discovery + news/intent signals.
# Get a key at https://app.tavily.com
#
# Free-tier keys retire mid-run under load (HTTP 432/quota), so pool several
# for rotation with a comma-separated TAVILY_API_KEYS. A single TAVILY_API_KEY
# also works, but gives you a 1-key pool with no fallback when it dies.
TAVILY_API_KEYS=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx,tvly-yyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Groq (optional) — entity second-opinion, fit rationales, false-positive
# challenge. Comma-separated for key rotation. Without this the pipeline runs
# fully on deterministic rules.
GROQ_API_KEYS=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Apify (optional) — apify/rag-web-browser actor, used for LLM-generated
# fresh-query discovery (query phrasing varies every run, to escape the
# static query_cooldown on config/queries.yaml). Get a token at
# https://console.apify.com/account/integrations
#
# Apify is billed by compute unit (full-page scrapes), not a flat per-call
# credit like Tavily, so keep discovery.apify.max_calls_per_run and
# max_results_per_query conservative until you've watched real spend in the
# Apify console. Comma-separated APIFY_TOKENS pools multiple accounts for
# rotation; a single APIFY_TOKEN also works. Without this, apify_discover
# is skipped and the rest of the pipeline runs unaffected.
APIFY_TOKENS=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
